# Copy to hosting/cloudflare/.dev.vars (next to wrangler.jsonc) for `npm run dev`. Never commit it.
PUBLIC_BASE_URL=http://localhost:5173
ADMIN_EMAILS=you@example.com
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Optional: in-app AI (imports, ingredient identification). Without it, AI features say they aren't set up.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: Find a photo (E1). Each source is off without its key. The recipe's own
# source page photo works without any key.
# Free stock photos (key shown on the docs page when signed in): https://pixabay.com/api/docs/
# PIXABAY_API_KEY=...
# Web image search (results labeled "from the web"): https://api-dashboard.search.brave.com/
# BRAVE_SEARCH_API_KEY=...
