{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cookbook",
  "main": "./worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Custom domain (D4). Requires chrisandelissa.com to be a zone in this Cloudflare account.
  "routes": [{ "pattern": "cookbook.chrisandelissa.com", "custom_domain": true }],
  "vars": {
    "PUBLIC_BASE_URL": "https://cookbook.chrisandelissa.com",
    // Comma-separated admin Google emails (D5). Set with the real addresses before deploying.
    "ADMIN_EMAILS": "REPLACE_WITH_ADMIN_EMAILS"
  },
  // Secrets (set with `wrangler secret put`, never committed):
  //   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookbook",
      // Replace with the id printed by `wrangler d1 create cookbook`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cookbook-media" }]
}
